<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="24dp">

    <!-- タイトル (一番上に配置) -->
    <TextView
        android:id="@+id/tvStep1Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/title_audio_test"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 再生ボタン (左側) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btSamplePlay"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:text="@string/action_play"
        android:textSize="18sp"
        android:textStyle="bold"
        app:icon="@android:drawable/ic_media_play"
        app:iconGravity="textStart"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toStartOf="@+id/btStop"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStep1Title" />

    <!-- 停止ボタン (右側) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btStop"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="8dp"
        android:enabled="false"
        android:text="@string/action_stop"
        android:textSize="18sp"
        android:textStyle="bold"
        app:icon="@android:drawable/ic_media_pause"
        app:iconGravity="textStart"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/btSamplePlay"
        app:layout_constraintTop_toTopOf="@id/btSamplePlay" />

</androidx.constraintlayout.widget.ConstraintLayout>